@model AvailableUnitsPageViewModel
@{
    ViewData["Title"] = "Available units";
}
<h1><i class="fa-solid fa-door-open me-2 text-primary" aria-hidden="true"></i>@ViewData["Title"]</h1>
@*
    The applicant's Available units page (2.b). Only shows units with no lease covering today (2.d), filtered in SQL.
    The property and bedroom filters are a GET form, same as on the application list. The Property, Bedrooms, Rent and
    Type headers are links that sort the list (in SQL, see PropertyService.GetAvailableUnitsAsync): click once for
    ascending, again for descending. They keep the filters, and the filter form keeps the sort.
*@
@{
    // One sortable column header. aria-sort tells screen readers which column is sorted and which way; the icon is
    // the same one the application grid uses and is just decoration.
    async Task SortableHeader(UnitSortColumn column, string title)
    {
        <th scope="col" aria-sort="@Model.AriaSort(column)">
            <a class="data-grid-sort" asp-action="Index" asp-route-propertyId="@Model.PropertyId" asp-route-bedrooms="@Model.Bedrooms"
               asp-route-sort="@column" asp-route-dir="@Model.NextDir(column)">@title<i class="fa-solid ms-1 @Model.SortIcon(column)" aria-hidden="true"></i></a>
        </th>
    }
}

<form method="get" class="row g-2 align-items-end mb-3">
    @* Keep the current sort when filtering (only when it isn't the default, to keep the URL short). *@
    @if (Model.Sort != UnitSortColumn.Property || Model.Dir != SortDirection.Asc)
    {
        <input type="hidden" name="sort" value="@Model.Sort" />
        <input type="hidden" name="dir" value="@Model.Dir" />
    }
    <div class="col-sm-6 col-md-4">
        <label for="propertyId" class="form-label">Property</label>
        <select id="propertyId" name="propertyId" asp-items="Model.Properties" class="form-select">
            <option value="">All properties</option>
        </select>
    </div>
    <div class="col-sm-4 col-md-3">
        <label for="bedrooms" class="form-label">Bedrooms</label>
        <select id="bedrooms" name="bedrooms" class="form-select">
            <option value="">Any</option>
            @for (var b = 1; b <= 3; b++)
            {
                <option value="@b" selected="@(Model.Bedrooms == b)">@b+</option>
            }
        </select>
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-outline-primary"><i class="fa-solid fa-filter me-1" aria-hidden="true"></i>Filter</button>
        @if (Model.IsFiltered)
        {
            <a asp-action="Index" class="btn btn-link"><i class="fa-solid fa-xmark me-1" aria-hidden="true"></i>Clear</a>
        }
    </div>
</form>

@if (Model.Units.Count == 0)
{
    <p class="text-muted">@(Model.IsFiltered ? "No units match those filters right now." : "No units are available right now.")</p>
}
else
{
    <div class="table-responsive">
        <table class="table">
            <thead>
                <tr>
                    @{ await SortableHeader(UnitSortColumn.Property, "Property"); }
                    <th scope="col">Unit</th>
                    @{ await SortableHeader(UnitSortColumn.Bedrooms, "Bedrooms"); }
                    @{ await SortableHeader(UnitSortColumn.Rent, "Rent"); }
                    @{ await SortableHeader(UnitSortColumn.Type, "Type"); }
                    <th scope="col"><span class="visually-hidden">Apply</span></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var unit in Model.Units)
                {
                    <tr>
                        <td>@unit.PropertyName</td>
                        <td>@unit.UnitNumber</td>
                        <td>@unit.Bedrooms</td>
                        <td>@unit.MonthlyRent.ToString("C")</td>
                        <td>@unit.UnitTypeName</td>
                        <td>
                            @* Apply is a POST since it creates an application. That way it has an antiforgery token,
                               and a crawler or link prefetch can't create applications just by following a URL. *@
                            <form asp-controller="Applications" asp-action="Start" method="post">
                                <input type="hidden" name="unitId" value="@unit.Id" />
                                <button type="submit" class="btn btn-sm btn-primary"><i class="fa-solid fa-paper-plane me-1" aria-hidden="true"></i>Apply</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

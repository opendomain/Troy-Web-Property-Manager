@model AvailableUnitsPageViewModel
@{
    ViewData["Title"] = "Available units";
}
<h1>@ViewData["Title"]</h1>
@*
    The applicant's Available units page (2.b). Only shows units with no lease covering today (2.d), filtered in SQL.
    The property and bedroom filters are a GET form, same as on the application list.
*@

<form method="get" class="row g-2 align-items-end mb-3">
    <div class="col-sm-6 col-md-4">
        <label for="propertyId" class="form-label">Property</label>
        <select id="propertyId" name="propertyId" asp-items="Model.Properties" class="form-select">
            <option value="">All properties</option>
        </select>
    </div>
    <div class="col-sm-4 col-md-3">
        <label for="bedrooms" class="form-label">Bedrooms</label>
        <select id="bedrooms" name="bedrooms" class="form-select">
            <option value="">Any</option>
            @for (var b = 1; b <= 3; b++)
            {
                <option value="@b" selected="@(Model.Bedrooms == b)">@b+</option>
            }
        </select>
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-outline-primary">Filter</button>
        @if (Model.IsFiltered)
        {
            <a asp-action="Index" class="btn btn-link">Clear</a>
        }
    </div>
</form>

@if (Model.Units.Count == 0)
{
    <p class="text-muted">@(Model.IsFiltered ? "No units match those filters right now." : "No units are available right now.")</p>
}
else
{
    <div class="table-responsive">
        <table class="table">
            <thead>
                <tr>
                    <th scope="col">Property</th>
                    <th scope="col">Unit</th>
                    <th scope="col">Bedrooms</th>
                    <th scope="col">Rent</th>
                    <th scope="col">Type</th>
                    <th scope="col"><span class="visually-hidden">Apply</span></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var unit in Model.Units)
                {
                    <tr>
                        <td>@unit.PropertyName</td>
                        <td>@unit.UnitNumber</td>
                        <td>@unit.Bedrooms</td>
                        <td>@unit.MonthlyRent.ToString("C0")</td>
                        <td>@unit.UnitTypeName</td>
                        <td>
                            @* Apply is a POST since it creates an application. That way it has an antiforgery token,
                               and a crawler or link prefetch can't create applications just by following a URL. *@
                            <form asp-controller="Applications" asp-action="Start" method="post">
                                <input type="hidden" name="unitId" value="@unit.Id" />
                                <button type="submit" class="btn btn-sm btn-primary">Apply</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

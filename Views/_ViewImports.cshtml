@* Namespaces and tag helpers for every MVC view, so views can use the models, rules and view models directly. *@
@using Microsoft.AspNetCore.Identity
@using Troy_Web_Property_Manager
@using Troy_Web_Property_Manager.Models
@using Troy_Web_Property_Manager.Rules
@using Troy_Web_Property_Manager.Services
@using Troy_Web_Property_Manager.ViewModels
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@* Turns on <vc:...> tags for our view components (note the assembly name has spaces in it). *@
@addTagHelper *, Troy Web Property Manager

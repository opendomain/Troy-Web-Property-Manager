@model ManagerNotesViewModel
@* data-modal-form: site.js posts this with fetch, then closes the modal and refreshes #manager-notes. *@
@*
    Modal for editing the managers' private notes. Managers only (the actions are role-restricted and the service
    checks again). Version rides along as a hidden field so a save based on stale notes comes back as a 409 with the
    message in the validation summary, instead of overwriting another manager's changes.
*@
<form asp-controller="Applications" asp-action="EditManagerNotes" asp-route-id="@Model.ApplicationId" method="post" data-modal-form>
    <input type="hidden" asp-for="Version" />
    <div class="modal-header">
        <h5 class="modal-title">Manager notes</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
    </div>
    <div class="modal-body">
        <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
        <p class="text-muted small">Only property managers can see these notes. Applicants never see them.</p>
        <div class="mb-3">
            <label asp-for="Notes" class="form-label"></label>
            <textarea asp-for="Notes" class="form-control" rows="8"></textarea>
            <span asp-validation-for="Notes" class="text-danger"></span>
        </div>
    </div>
    <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="submit" class="btn btn-primary">Save notes</button>
    </div>
</form>

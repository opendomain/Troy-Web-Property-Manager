@model ResidenceViewModel
@* data-modal-form: site.js posts this with fetch, then closes the modal and refreshes #residence-history. *@
@*
    Modal for adding or editing a residence (4.c, Technical 1.b).
    - ApplicationsController.Residence (GET) returns this, and site.js puts it in the shared modal.
    - If the POST doesn't validate, we get this same partial back with a 422 and the errors filled in, so the modal
      redraws and keeps what they typed. If it works we get JSON and the modal closes.
    - The form tag helper adds the antiforgery token and site.js posts the whole form, token and all.
    - Required/length/phone checks come from DataAnnotations (browser and server). "Move-out on or after move-in" is
      the view model's IValidatableObject rule (server only) and shows under Move-out date.
    - It saves even with errors (data-save-invalid tells site.js not to stop it in the browser). If errors are left,
      the controller sends this back on the saved residence with the errors under their fields and the "saved" note,
      and data-refresh-* tells site.js to redraw the residence list behind the modal.
*@
<form asp-controller="Applications" asp-action="Residence" asp-route-id="@Model.ApplicationId" method="post" data-modal-form data-save-invalid
      data-refresh-target="@(Model.SavedWithErrors ? "#residence-history" : null)"
      data-refresh-url="@(Model.SavedWithErrors ? Url.Action("Residences", "Applications", new { id = Model.ApplicationId }) : null)">
    @* Empty when adding. When editing, the service only looks for this id inside this user's own application. *@
    <input type="hidden" asp-for="ResidenceId" />
    @* Residence History's version when this modal opened. If another applicant saves the section meanwhile, saving
       comes back as a 409 with a "reload" message instead of overwriting their change. *@
    <input type="hidden" asp-for="SectionVersion" />
    <div class="modal-header">
        <h5 class="modal-title">@(Model.ResidenceId is null ? "Add residence" : "Edit residence")</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
    </div>
    <div class="modal-body">
        @if (Model.SavedWithErrors)
        {
            <div class="alert alert-warning" role="status"><i class="fa-solid fa-triangle-exclamation me-2" aria-hidden="true"></i>Saved, but some fields still need fixing before you can submit.</div>
        }
        <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
        <div class="mb-3">
            <label asp-for="Address" class="form-label"></label>
            <input asp-for="Address" class="form-control" />
            <span asp-validation-for="Address" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="LandlordName" class="form-label"></label>
            <input asp-for="LandlordName" class="form-control" />
            <span asp-validation-for="LandlordName" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="LandlordPhone" class="form-label"></label>
            <input asp-for="LandlordPhone" class="form-control" />
            <span asp-validation-for="LandlordPhone" class="text-danger"></span>
        </div>
        @* type="date" plus the ISO format gets us the browser's date picker, and it binds straight back to DateOnly. *@
        <div class="row">
            <div class="col mb-3">
                <label asp-for="MoveInDate" class="form-label"></label>
                <input asp-for="MoveInDate" type="date" asp-format="{0:yyyy-MM-dd}" class="form-control" />
                <span asp-validation-for="MoveInDate" class="text-danger"></span>
            </div>
            <div class="col mb-3">
                <label asp-for="MoveOutDate" class="form-label"></label>
                <input asp-for="MoveOutDate" type="date" asp-format="{0:yyyy-MM-dd}" class="form-control" />
                <span asp-validation-for="MoveOutDate" class="text-danger"></span>
            </div>
        </div>
    </div>
    <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
        @* formnovalidate: jQuery validation would otherwise cancel the submit when a required field is blank, and this
           form saves even with errors (data-save-invalid) - the server sends them back. Same as section 1's Continue. *@
        <button type="submit" class="btn btn-primary" formnovalidate><i class="fa-solid fa-floppy-disk me-1" aria-hidden="true"></i>Save</button>
    </div>
</form>

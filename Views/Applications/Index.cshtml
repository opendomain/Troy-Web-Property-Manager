@model ApplicationListViewModel
@{
    ViewData["Title"] = "Applications";
}
<h1>@(User.IsInRole(Roles.PropertyManager) ? "Applications" : "My applications")</h1>
@* GET form: the filters go into the query string and ApplicationService.ListAsync applies them in SQL. *@
<form method="get" class="row g-2 mb-3">
    <div class="col-auto">
        <select class="form-select" asp-for="Status" asp-items="Html.GetEnumSelectList<ApplicationStatus>()">
            <option value="">All statuses</option>
        </select>
    </div>
    <div class="col-auto">
        <select class="form-select" asp-for="PropertyId" asp-items="Model.Properties">
            <option value="">All properties</option>
        </select>
    </div>
    <div class="col-auto"><button type="submit" class="btn btn-outline-primary">Filter</button></div>
</form>
<table class="table">
    <thead>
        <tr><th>#</th><th>Property / unit</th><th>Applicant</th><th>Status</th><th>Submitted</th></tr>
    </thead>
    <tbody>
        @foreach (var item in Model.Items)
        {
            <tr>
                <td><a asp-action="Edit" asp-route-id="@item.Id">@item.Id</a></td>
                <td>@item.PropertyName · @item.UnitNumber</td>
                <td>@item.Applicant</td>
                <td>@item.Status</td>
                <td>@item.SubmittedAt?.ToLocalTime().ToShortDateString()</td>
            </tr>
        }
    </tbody>
</table>
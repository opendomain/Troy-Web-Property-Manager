@model ApplicationListViewModel
@{

    ViewData["Title"] = User.IsInRole(AppRoles.PropertyManager) ? "Applications" : "My applications";
}
<h1>@ViewData["Title"]</h1>

@*
    The application list (6.a). Both roles use this same view - the controller and service decide which rows you get
    (applicants see their own, managers see all), so apart from the title there's no role logic in here.
*@
@* GET form: the filters go into the query string and ApplicationService.ListAsync applies them in SQL. *@
@* Using GET instead of POST means filtering is safe to repeat, you can bookmark it, and there's no antiforgery
   token to worry about. The status dropdown comes from the enum, so it always has every status. *@
<form method="get" class="row g-2 align-items-end mb-3">
    <div class="col-auto">
        <label asp-for="Status" class="form-label"></label>
        <select class="form-select" asp-for="Status" asp-items="Html.GetEnumSelectList<ApplicationStatus>()">
            <option value="">All statuses</option>
        </select>
    </div>
    <div class="col-auto">
        <label asp-for="PropertyId" class="form-label">Property</label>
        <select class="form-select" asp-for="PropertyId" asp-items="Model.Properties">
            <option value="">All properties</option>
        </select>
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-outline-primary">Filter</button>
        <a asp-action="Index" class="btn btn-link">Clear</a>
    </div>
</form>

@if (Model.Items.Count == 0)
{
    <p class="text-muted">No applications found.</p>
}
else
{
    <div class="table-responsive">
        <table class="table">
            <thead>
                <tr>
                    <th scope="col">#</th>
                    <th scope="col">Property / unit</th>
                    <th scope="col">Applicant</th>
                    <th scope="col">Status</th>
                    <th scope="col">Submitted</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.Items)
                {
                    <tr>
                        <td><a asp-action="Edit" asp-route-id="@item.Id">@item.Id</a></td>
                        <td>@item.PropertyName · @item.UnitNumber</td>
                        <td>@item.Applicant</td>
                        <td>@item.Status</td>
                        @* Times are stored in server local time, so they're shown as-is. *@
                        <td>@item.SubmittedAt?.ToShortDateString()</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

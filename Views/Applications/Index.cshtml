@model ApplicationListViewModel
@{

    ViewData["Title"] = User.IsInRole(AppRoles.PropertyManager) ? "Applications" : "My applications";
}
<h1><i class="fa-solid fa-file-lines me-2 text-primary" aria-hidden="true"></i>@ViewData["Title"]</h1>

@*
    The application list (6.a). Both roles use this same view - the API and service decide which rows you get
    (applicants see their own, managers see all), so apart from the title there's no role logic in here.
*@
@* GET form: the filters go into the query string. The data grid below sends them with each request to
   /api/applications, where ApplicationService.ListAsync applies them in SQL, and submitting it reloads just the grid.
   Using GET instead of POST means filtering is safe to repeat, you can bookmark it, and there's no antiforgery
   token to worry about. The status dropdown comes from the enum, so it always has every status. *@
<form id="application-filters" method="get" class="row g-2 align-items-end mb-3">
    <div class="col-auto">
        <label asp-for="Status" class="form-label"></label>
        <select class="form-select" asp-for="Status" asp-items="Html.GetEnumSelectList<ApplicationStatus>()">
            <option value="">All statuses</option>
        </select>
    </div>
    <div class="col-auto">
        <label asp-for="PropertyId" class="form-label">Property</label>
        <select class="form-select" asp-for="PropertyId" asp-items="Model.Properties">
            <option value="">All properties</option>
        </select>
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-outline-primary"><i class="fa-solid fa-filter me-1" aria-hidden="true"></i>Filter</button>
        <a asp-action="Index" class="btn btn-link"><i class="fa-solid fa-xmark me-1" aria-hidden="true"></i>Clear</a>
    </div>
</form>

@* The column keys are the sort values /api/applications accepts (ApplicationSortColumn); the fields are its JSON
   properties. Newest application first until someone picks a column. Submitted times are stored in server local
   time, so they're shown as-is. *@
@{
    var grid = new DataGridViewModel
    {
        Id = "application-grid",
        DataUrl = Url.RouteUrl("ListApplications")!,
        Caption = (string)ViewData["Title"]!,
        FilterFormId = "application-filters",
        DefaultSort = nameof(ApplicationSortColumn.Id),
        DefaultDir = "desc",
        EmptyText = "No applications found.",
        Columns =
        [
            new() { Key = nameof(ApplicationSortColumn.Id), Title = "#", Field = "id", Href = Url.Action("Edit") + "/{id}" },
            new() { Key = nameof(ApplicationSortColumn.Property), Title = "Property / unit", Template = "{propertyName} · {unitNumber}" },
            new() { Key = nameof(ApplicationSortColumn.Applicant), Title = "Applicant", Field = "applicant" },
            new() { Key = nameof(ApplicationSortColumn.Status), Title = "Status", Field = "statusName" },
            new() { Key = nameof(ApplicationSortColumn.Submitted), Title = "Submitted", Field = "submittedAt", Format = DataGridFormat.Date }
        ]
    };
}
<vc:data-grid grid="grid" />

@model ReviewViewModel
@* data-modal-form: site.js posts this with fetch; on success the page reloads (status, buttons and history change). *@
<form asp-controller="Applications" asp-action="Review" asp-route-id="@Model.ApplicationId" method="post" data-modal-form>
    <div class="modal-header">
        <h5 class="modal-title">Review application #@Model.ApplicationId</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
    </div>
    <div class="modal-body">
        <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
        <fieldset class="mb-3">
            <legend class="form-label fs-6">Outcome</legend>
            @foreach (var outcome in Enum.GetValues<ReviewOutcome>())
            {
                <div class="form-check">
                    <input class="form-check-input" type="radio" asp-for="Outcome" value="@outcome" id="outcome-@outcome" />
                    <label class="form-check-label" for="outcome-@outcome">@outcome</label>
                </div>
            }
            <span asp-validation-for="Outcome" class="text-danger"></span>
        </fieldset>
        <div class="mb-3">
            <label asp-for="Comment" class="form-label">Comment (required for Return and Deny)</label>
            <textarea asp-for="Comment" class="form-control" rows="3"></textarea>
            <span asp-validation-for="Comment" class="text-danger"></span>
        </div>
    </div>
    <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="submit" class="btn btn-primary">Save review</button>
    </div>
</form>

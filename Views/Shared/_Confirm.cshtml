@model ConfirmViewModel

@* data-modal-form: site.js posts this with fetch, then closes the modal and refreshes on success. *@
<form action="@Model.Action" method="post" data-modal-form>
    @Html.AntiForgeryToken()
    <div class="modal-header">
        <h5 class="modal-title">@Model.Title</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
    </div>
    <div class="modal-body">
        <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
        <p class="mb-0">@Model.Message</p>
    </div>
    <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="submit" class="btn btn-danger">@Model.ConfirmText</button>
    </div>
</form>

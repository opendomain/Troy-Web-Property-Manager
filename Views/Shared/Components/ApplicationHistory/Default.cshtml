@model List<HistoryItemViewModel>
@*
    The view for ApplicationHistoryViewComponent (5.c: who, when, comment). MVC finds it here by convention
    (Views/Shared/Components/ApplicationHistory/Default.cshtml). Managers only - the component returns nothing for
    anyone else. Comments go out through @ so they're HTML-encoded; if someone types markup it just shows as text.
*@
<div class="card">
    <div class="card-header"><i class="fa-solid fa-clock-rotate-left me-2" aria-hidden="true"></i>History</div>
    <ul class="list-group list-group-flush">
        @foreach (var item in Model)
        {
            <li class="list-group-item">
                <strong>@(item.FromStatus is { } from ? $"{from.DisplayName()} → {item.ToStatus.DisplayName()}" : "Created")</strong>
                @if (item.Outcome is not null)
                {
                    <span>(@item.Outcome)</span>
                }
                @* ChangedAt is saved in server local time, so we show it as-is. *@
                <div class="small text-muted">@item.ChangedBy · @item.ChangedAt.ToString("g")</div>
                @if (!string.IsNullOrEmpty(item.Comment))
                {
                    <div class="small">@item.Comment</div>
                }
            </li>
        }
    </ul>
</div>

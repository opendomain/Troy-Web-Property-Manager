@model UnitFormViewModel
@*
    Add/edit unit modal (2.b, Technical 1.b): unit number, bedrooms, monthly rent, unit type.
    Works the same way as _PropertyForm. The server builds the unit type dropdown (Model.UnitTypes): active types,
    plus this unit's current type if it's inactive (2.c). Even if someone edits the HTML, the server won't accept an
    inactive type for any other unit, and a duplicate unit number comes back as an error under Unit number.
*@
<form asp-controller="Properties" asp-action="EditUnit" asp-route-id="@Model.Id" method="post" data-modal-form>
    @* Only matters when adding - an existing unit stays with its saved property. *@
    <input type="hidden" asp-for="PropertyId" />
    <div class="modal-header">
        <h5 class="modal-title">@(Model.Id is null ? "Add unit" : "Edit unit")</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
    </div>
    <div class="modal-body">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <div class="mb-3">
            <label asp-for="UnitNumber" class="form-label"></label>
            <input asp-for="UnitNumber" class="form-control" />
            <span asp-validation-for="UnitNumber" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="Bedrooms" class="form-label"></label>
            <input asp-for="Bedrooms" class="form-control" />
            <span asp-validation-for="Bedrooms" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="MonthlyRent" class="form-label"></label>
            <input asp-for="MonthlyRent" class="form-control" />
            <span asp-validation-for="MonthlyRent" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="UnitTypeId" class="form-label"></label>
            <select asp-for="UnitTypeId" asp-items="Model.UnitTypes" class="form-select">
                <option value="">Choose…</option>
            </select>
            <span asp-validation-for="UnitTypeId" class="text-danger"></span>
        </div>
    </div>
    <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="submit" class="btn btn-primary"><i class="fa-solid fa-floppy-disk me-1" aria-hidden="true"></i>Save</button>
    </div>
</form>

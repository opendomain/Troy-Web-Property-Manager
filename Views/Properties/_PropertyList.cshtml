@model List<PropertyViewModel>
@* What goes inside #property-list in Index.cshtml. site.js swaps this in after a save. *@
@*
    One card per property (each one is _PropertyCard). Index.cshtml renders this on first load, and
    PropertiesController.List returns it on its own after a property is added or removed. Edits to a single
    property or its units only redraw that one card.
*@
@foreach (var property in Model)
{
    <partial name="_PropertyCard" model="property" />
}

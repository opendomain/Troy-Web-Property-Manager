@model PropertyFormViewModel
@*
    Add/edit property modal (2.b, Technical 1.b). Same partial for both - no Id means we're adding.
    data-modal-form tells site.js to post it with fetch. A 422 means it's this partial again with errors (redrawn in
    the modal); JSON means it worked, so the modal closes and #property-list refreshes. The form tag helper adds the
    antiforgery token.
*@
<form asp-controller="Properties" asp-action="Edit" asp-route-id="@Model.Id" method="post" data-modal-form>
    <div class="modal-header">
        <h5 class="modal-title">@(Model.Id is null ? "Add property" : "Edit property")</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
    </div>
    <div class="modal-body">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <div class="mb-3">
            <label asp-for="Name" class="form-label"></label>
            <input asp-for="Name" class="form-control" />
            <span asp-validation-for="Name" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="Address" class="form-label"></label>
            <input asp-for="Address" class="form-control" />
            <span asp-validation-for="Address" class="text-danger"></span>
        </div>
    </div>
    <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="submit" class="btn btn-primary">Save</button>
    </div>
</form>

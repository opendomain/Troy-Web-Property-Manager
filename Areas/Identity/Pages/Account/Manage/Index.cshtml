@page
@model Troy_Web_Property_Manager.Areas.Identity.Pages.Account.Manage.IndexModel
@{
    ViewData["Title"] = "Profile";
}

<h1><i class="fa-solid fa-circle-user me-2 text-primary" aria-hidden="true"></i>@ViewData["Title"]</h1>

@if (!string.IsNullOrEmpty(Model.StatusMessage))
{
    var alertClass = Model.StatusMessage.StartsWith("Unexpected error") ? "alert-danger" : "alert-success";
    <div class="alert @alertClass" role="alert">@Model.StatusMessage</div>
}

@* Same as Register: the form sits in a column so the fields aren't page-wide. *@
<div class="row">
    <div class="col-md-6 col-lg-4">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
            <div class="form-group">
                <label for="username">Username</label>
                <input id="username" value="@Model.Username" class="form-control" disabled />
            </div>
            <div class="form-group">
                <label asp-for="Input.PhoneNumber"></label>
                <input asp-for="Input.PhoneNumber" class="form-control" autocomplete="tel" />
                <span asp-validation-for="Input.PhoneNumber" class="text-danger"></span>
            </div>
            <button type="submit" class="btn btn-primary mt-2"><i class="fa-solid fa-floppy-disk me-1" aria-hidden="true"></i>Save</button>
        </form>
    </div>
</div>

<p class="mt-3"><a class="btn btn-outline-secondary" asp-page="./ChangePassword"><i class="fa-solid fa-key me-1" aria-hidden="true"></i>Change your password</a></p>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

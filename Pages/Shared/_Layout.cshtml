<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Troy Web Property Manager</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    @* Font Awesome Free (solid icons only), kept in wwwroot/lib like Bootstrap. Icons are decorative
       (aria-hidden) - every button and link keeps its text. *@
    <link rel="stylesheet" href="~/lib/fontawesome/css/fontawesome.min.css" />
    <link rel="stylesheet" href="~/lib/fontawesome/css/solid.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @* The scoped-CSS bundle (_Layout.cshtml.css) is named after the assembly, spaces and all. *@
    <link rel="stylesheet" href="~/Troy Web Property Manager.styles.css" asp-append-version="true" />
</head>
@{
    // Which menu link is the current page, so it can be highlighted (and announced with aria-current).
    var controller = ViewContext.RouteData.Values["controller"] as string;
    var action = ViewContext.RouteData.Values["action"] as string;
    var page = ViewContext.RouteData.Values["page"] as string;
    bool IsController(string name) => string.Equals(controller, name, StringComparison.OrdinalIgnoreCase);
    bool IsPage(string name) => controller is null && string.Equals(page, name, StringComparison.OrdinalIgnoreCase);
    string NavClass(bool active) => active ? "nav-link active" : "nav-link";
    string? Current(bool active) => active ? "page" : null;
    var onQueue = IsController("Applications") && string.Equals(action, "Queue", StringComparison.OrdinalIgnoreCase);
}
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light app-navbar box-shadow mb-4">
            <div class="container">
                <a class="navbar-brand" asp-area="" asp-page="/Index"><i class="fa-solid fa-city me-2" aria-hidden="true"></i>Troy Web Property Manager</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="@NavClass(IsPage("/Index"))" aria-current="@Current(IsPage("/Index"))" asp-area="" asp-page="/Index"><i class="fa-solid fa-house me-1" aria-hidden="true"></i>Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="@NavClass(IsPage("/Privacy"))" aria-current="@Current(IsPage("/Privacy"))" asp-area="" asp-page="/Privacy"><i class="fa-solid fa-shield-halved me-1" aria-hidden="true"></i>Privacy</a>
                        </li>

                        @* Menu links depend on your role. This is just about which links you see - the real access
                           check is [Authorize(Roles = ...)] on the controllers. asp-area="" keeps the links working
                           when the layout is rendered from the Identity area. *@
                        @if (User.IsInRole(AppRoles.PropertyManager))
                        {
                            <li class="nav-item"><a class="@NavClass(IsController("Properties"))" aria-current="@Current(IsController("Properties"))" asp-area="" asp-controller="Properties" asp-action="Index"><i class="fa-solid fa-building me-1" aria-hidden="true"></i>Properties</a></li>
                            <li class="nav-item"><a class="@NavClass(IsController("Applications") && !onQueue)" aria-current="@Current(IsController("Applications") && !onQueue)" asp-area="" asp-controller="Applications" asp-action="Index"><i class="fa-solid fa-file-lines me-1" aria-hidden="true"></i>Applications</a></li>
                            <li class="nav-item"><a class="@NavClass(onQueue)" aria-current="@Current(onQueue)" asp-area="" asp-controller="Applications" asp-action="Queue"><i class="fa-solid fa-list-check me-1" aria-hidden="true"></i>Review queue</a></li>
                        }
                        else if (User.IsInRole(AppRoles.Applicant))
                        {
                            <li class="nav-item"><a class="@NavClass(IsController("Units"))" aria-current="@Current(IsController("Units"))" asp-area="" asp-controller="Units" asp-action="Index"><i class="fa-solid fa-door-open me-1" aria-hidden="true"></i>Available units</a></li>
                            <li class="nav-item"><a class="@NavClass(IsController("Applications"))" aria-current="@Current(IsController("Applications"))" asp-area="" asp-controller="Applications" asp-action="Index"><i class="fa-solid fa-file-lines me-1" aria-hidden="true"></i>My applications</a></li>
                        }
                    </ul>
                    <partial name="_LoginPartial" />
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @* One-off success/error messages from the controllers (AppController.SetMessage/SetError). TempData
               survives the redirect after a POST and clears once it's shown. Output with @, so it's HTML-encoded. *@
            @if (TempData["Message"] is string message)
            {
                <div class="alert alert-success alert-dismissible fade show" role="status">
                    <i class="fa-solid fa-circle-check me-2" aria-hidden="true"></i>@message
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }
            @if (TempData["Error"] is string error)
            {
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    <i class="fa-solid fa-circle-exclamation me-2" aria-hidden="true"></i>@error
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }
            @RenderBody()
        </main>
    </div>

    @* The one shared modal. Every modal in the app (property, unit, residence, review, confirm) reuses it - site.js
       fills .modal-content with whatever partial the controller returns, so the forms are plain server-rendered
       Razor, not JavaScript templates (Technical 1.b). *@
    <div class="modal fade" id="app-modal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-lg modal-dialog-scrollable">
            <div class="modal-content"></div>
        </div>
    </div>

    <footer class="footer">
        <div class="container">
            &copy; 2026 - Troy Web Property Manager - <a asp-area="" asp-page="/Privacy">Privacy</a>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @* No SPA framework (the assessment rules that out) - just Bootstrap for the modal, jQuery for unobtrusive
       validation, and our small site.js for the modal plumbing. asp-append-version adds a hash so browsers grab
       a new site.js as soon as it changes. *@
    <script src="~/js/site.js" asp-append-version="true"></script>
    @* grid.js drives any <vc:data-grid> on the page (sorting and paging from a JSON endpoint); it does nothing elsewhere. *@
    <script src="~/js/grid.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

    <partial name="_GoatCounter" />
</body>
</html>

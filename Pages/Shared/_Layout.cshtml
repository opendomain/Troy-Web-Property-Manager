<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Troy Web Property Manager</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @* The scoped-CSS bundle (_Layout.cshtml.css) is named after the assembly, spaces and all. *@
    <link rel="stylesheet" href="~/Troy Web Property Manager.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container">
                <a class="navbar-brand" asp-area="" asp-page="/Index">Troy Web Property Manager</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-page="/Index">Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-page="/Privacy">Privacy</a>
                        </li>

                        @* Menu links depend on your role. This is just about which links you see - the real access
                           check is [Authorize(Roles = ...)] on the controllers. asp-area="" keeps the links working
                           when the layout is rendered from the Identity area. *@
                        @if (User.IsInRole(AppRoles.PropertyManager))
                        {
                            <li class="nav-item"><a class="nav-link text-dark" asp-area="" asp-controller="Properties" asp-action="Index">Properties</a></li>
                            <li class="nav-item"><a class="nav-link text-dark" asp-area="" asp-controller="Applications" asp-action="Index">Applications</a></li>
                            <li class="nav-item"><a class="nav-link text-dark" asp-area="" asp-controller="Applications" asp-action="Queue">Review queue</a></li>
                        }
                        else if (User.IsInRole(AppRoles.Applicant))
                        {
                            <li class="nav-item"><a class="nav-link text-dark" asp-area="" asp-controller="Units" asp-action="Index">Available units</a></li>
                            <li class="nav-item"><a class="nav-link text-dark" asp-area="" asp-controller="Applications" asp-action="Index">My applications</a></li>
                        }
                    </ul>
                    <partial name="_LoginPartial" />
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @* One-off success/error messages from the controllers (AppController.SetMessage/SetError). TempData
               survives the redirect after a POST and clears once it's shown. Output with @, so it's HTML-encoded. *@
            @if (TempData["Message"] is string message)
            {
                <div class="alert alert-success alert-dismissible fade show" role="status">
                    @message
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }
            @if (TempData["Error"] is string error)
            {
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    @error
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }
            @RenderBody()
        </main>
    </div>

    @* The one shared modal. Every modal in the app (property, unit, residence, review, confirm) reuses it - site.js
       fills .modal-content with whatever partial the controller returns, so the forms are plain server-rendered
       Razor, not JavaScript templates (Technical 1.b). *@
    <div class="modal fade" id="app-modal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-lg modal-dialog-scrollable">
            <div class="modal-content"></div>
        </div>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - Troy Web Property Manager - <a asp-area="" asp-page="/Privacy">Privacy</a>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @* No SPA framework (the assessment rules that out) - just Bootstrap for the modal, jQuery for unobtrusive
       validation, and our small site.js for the modal plumbing. asp-append-version adds a hash so browsers grab
       a new site.js as soon as it changes. *@
    <script src="~/js/site.js" asp-append-version="true"></script>
    @* grid.js drives any <vc:data-grid> on the page (sorting and paging from a JSON endpoint); it does nothing elsewhere. *@
    <script src="~/js/grid.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

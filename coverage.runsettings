<?xml version="1.0" encoding="utf-8"?>
<!--
  Code coverage settings for both test projects (see "Code coverage" in README.md).

  Visual Studio: Test > Configure Run Settings > Select Solution Wide runsettings File > this file, then
  Test > Analyze Code Coverage for All Tests.
  Command line: ./coverage.ps1 (runs the tests with these settings and builds the HTML report).

  Only the app's own hand-written code is measured: the test assemblies, packages, EF migrations, Razor views and
  source-generated files are left out, so the numbers show how much of our logic the tests exercise.
-->
<RunSettings>
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="Code Coverage">
        <Configuration>
          <CodeCoverage>
            <!-- Just the web app. The UI tests host it in-process (WebApplicationFactory), so their requests count too. -->
            <ModulePaths>
              <Include>
                <ModulePath>.*[\\/]Troy Web Property Manager\.dll$</ModulePath>
              </Include>
            </ModulePaths>
            <Sources>
              <Exclude>
                <!-- Generated by dotnet ef. -->
                <Source>.*[\\/]Data[\\/]Migrations[\\/].*</Source>
                <!-- Source generators (OpenAPI XML comments and the like). -->
                <Source>.*[\\/]obj[\\/].*</Source>
                <!-- Razor views and pages markup; the code-behind (.cshtml.cs) is still measured. -->
                <Source>.*\.cshtml$</Source>
              </Exclude>
            </Sources>
            <Attributes>
              <Exclude>
                <Attribute>^System\.CodeDom\.Compiler\.GeneratedCodeAttribute$</Attribute>
                <Attribute>^System\.Diagnostics\.CodeAnalysis\.ExcludeFromCodeCoverageAttribute$</Attribute>
              </Exclude>
            </Attributes>
          </CodeCoverage>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>
